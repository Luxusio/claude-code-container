{
  "name": "@ccc/device-lab",
  "version": "1.1.90",
  "type": "module",
  "description": "Device providers, host broker and ownership state",
  "exports": {
    ".": "./dist/index.js",
    "./*.js": "./dist/*.js",
    "./providers/*": "./providers/*",
    "./appium-runtime/*": "./appium-runtime/*",
    "./providers/domain/android-control-transfer.mjs": "./providers/adapters/android-control-transfer.mjs",
    "./providers/domain/device-observation.mjs": "./providers/adapters/macos-observation-plan.mjs"
  },
  "bin": {
    "ccc-device-broker": "./dist/broker-entry.js"
  },
  "files": [
    "dist/",
    "providers/",
    "powershell/",
    "appium-runtime/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@ccc/hyper-v": "1.1.90"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "license": "MIT"
}
