{
  "name": "claude-code-container",
  "version": "1.1.90",
  "description": "Run Claude Code in isolated Docker containers",
  "type": "module",
  "bin": {
    "ccc": "dist/index.js"
  },
  "files": [
    "dist/",
    "Dockerfile",
    "Dockerfile.distribution",
    "Containerfile",
    "device-lab-mcp/package.json",
    "device-lab-mcp/server.mjs",
    "device-lab-mcp/src/",
    "device-lab-mcp/scripts/build.mjs",
    "scripts/run-vitest.mjs",
    "scripts/test-level.js",
    "scripts/durability/",
    "scripts/real-tests/",
    "scripts/install.js",
    "scripts/build-distribution-image.mjs",
    "scripts/localhost-proxy/",
    "scripts/ccc-entrypoint.sh",
    "scripts/clipboard-shims/",
    "scripts/ccc-x11-bridge",
    "scripts/clipboard-helper-darwin.m",
    "README.md",
    "doc/hyper-v-windows/GUIDE__typed-library-support.md",
    "scripts/workspace-build.mjs",
    "scripts/windows-lx-workspace-link.mjs",
    "packages/device-lab/providers/state/windows-system-powershell.mjs"
  ],
  "scripts": {
    "build": "npm run build:packages && npm run assemble:packages && npm run test:hyper-v:static && tsc && npm run typecheck:hyper-v:windows:contracts && npm run typecheck:real-tests && npm run typecheck:tests && npm run typecheck:architecture && npm run bundle:hyper-v:windows:library-test && npm run bundle:hyper-v:windows:library-privileged-test && npm run bundle:hyper-v:windows:network-host-test && node -e \"const fs=require('fs');const v=require('./package.json').version;const f='dist/utils.js';fs.writeFileSync(f,fs.readFileSync(f,'utf8').replace('__CLI_VERSION__',v))\" && npm run build:device-lab-mcp && npm run bundle:codex-resume-runtime && npm run assemble:packages",
    "bundle:codex-resume-runtime": "node node_modules/esbuild-wasm/bin/esbuild src/codex-resume-recovery-entry.ts --bundle --platform=node --format=cjs --target=node20 --outfile=dist/codex-resume-runtime.cjs",
    "build:hyper-v:windows:library": "npm run build --workspace @ccc/hyper-v && npm run bundle:hyper-v:windows:library-test && npm run bundle:hyper-v:windows:library-privileged-test && npm run bundle:hyper-v:windows:network-host-test",
    "bundle:hyper-v:windows:library-test": "node node_modules/esbuild-wasm/bin/esbuild scripts/real-tests/hyper-v-windows-library.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/real-tests/hyper-v-windows-library.mjs",
    "bundle:hyper-v:windows:library-privileged-test": "node node_modules/esbuild-wasm/bin/esbuild scripts/real-tests/hyper-v-windows-library-privileged.ts --bundle --platform=node --format=esm --target=node20 --loader:.ps1=text --outfile=dist/real-tests/hyper-v-windows-library-privileged.mjs",
    "bundle:hyper-v:windows:network-host-test": "node node_modules/esbuild-wasm/bin/esbuild scripts/real-tests/hyper-v-windows-network-host.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/real-tests/hyper-v-windows-network-host.mjs",
    "build:device-lab-mcp": "node device-lab-mcp/scripts/build.mjs --outfile dist/device-lab-mcp/server.mjs",
    "test": "node scripts/run-vitest.mjs run",
    "test:level0": "node scripts/test-level.js 0",
    "test:level1": "node scripts/test-level.js 1",
    "test:level2": "node scripts/test-level.js 2",
    "test:level3": "node scripts/real-tests/level3.ts",
    "test:level3:hyper-v": "node scripts/real-tests/hyper-v.ts",
    "test:hyper-v:nested": "node --import tsx scripts/real-tests/nested-hyper-v.ts",
    "test:level3:hyper-v:windows": "node scripts/real-tests/hyper-v.ts --target windows",
    "test:level3:hyper-v:windows:library": "node scripts/real-tests/hyper-v-windows-library-command.mjs",
    "test:level3:hyper-v:windows:network:library": "node scripts/real-tests/hyper-v-windows-network-command.mjs",
    "test:level3:hyper-v:linux": "node scripts/real-tests/hyper-v.ts --target linux",
    "test:hyper-v:contracts": "node --import tsx scripts/validate-hyper-v-contracts.ts",
    "test:hyper-v:powershell": "node scripts/validate-hyper-v-powershell.mjs",
    "test:hyper-v:pester": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File packages/device-lab/powershell/install-test-modules.ps1 && node scripts/validate-hyper-v-powershell.mjs --require-parser --pester",
    "test:hyper-v:package": "node scripts/test-hyper-v-package.mjs",
    "test:hyper-v:ubuntu-image": "node --import tsx scripts/verify-hyper-v-ubuntu-image.ts",
    "test:hyper-v:static": "npm run test:hyper-v:contracts && npm run test:hyper-v:powershell",
    "typecheck:real-tests": "tsc -p tsconfig.real-tests.json",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "typecheck:architecture": "tsc -p tsconfig.architecture.json",
    "typecheck:hyper-v:windows:contracts": "tsc -p tsconfig.hyper-v-windows.type-contracts.json",
    "test:durability:device-lab": "node scripts/durability/run.mjs broker",
    "test:durability:device-lab:real": "node scripts/durability/run.mjs real",
    "test:durability:device-lab:real:self": "node --test scripts/durability/*.self-test.mjs",
    "test:watch": "node scripts/run-vitest.mjs",
    "lint": "eslint src/ packages/hyper-v/src/ packages/device-lab/src/",
    "install:global": "node scripts/install.js",
    "uninstall:global": "node scripts/install.js --uninstall",
    "prepublishOnly": "npm run build",
    "postinstall": "node scripts/install.js --postinstall",
    "build:packages": "node scripts/workspace-build.mjs build",
    "assemble:packages": "node scripts/workspace-build.mjs assemble",
    "test:packages": "npm run test --workspace @ccc/hyper-v && npm run test --workspace @ccc/device-lab && npm run test --workspace @ccc/device-lab-mcp && node scripts/test-workspace-packages.mjs"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "keywords": [
    "claude",
    "container",
    "sandbox",
    "docker",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Luxusio/claude-code-container.git"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@types/node": "^22.0.0",
    "esbuild-wasm": "^0.28.0",
    "eslint": "^9.0.0",
    "eslint-plugin-n": "^17.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.1.2",
    "@ccc/device-lab": "1.1.90",
    "@ccc/hyper-v": "1.1.90"
  },
  "workspaces": [
    "packages/*",
    "device-lab-mcp"
  ],
  "imports": {
    "#device-lab/providers/*": "./dist/packages/device-lab/providers/*",
    "#device-lab/*.js": "./dist/packages/device-lab/dist/*.js",
    "#hyper-v": "./dist/packages/hyper-v/dist/index.js",
    "#hyper-v/low-level": "./dist/packages/hyper-v/dist/low-level/index.js",
    "#hyper-v/lifecycle": "./dist/packages/hyper-v/dist/lifecycle/index.js",
    "#hyper-v/*.js": "./dist/packages/hyper-v/dist/*.js",
    "#hyper-v/powershell/*": "./dist/packages/hyper-v/powershell/*"
  }
}
