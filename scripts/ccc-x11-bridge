#!/bin/bash
# Synchronize the host clipboard and the container X11 CLIPBOARD selection.
# Direct X11 clients (including arboard) bypass the shell clipboard shims.

: "${DISPLAY_N:=:99}"
: "${LOCK_DIR:=/run/ccc-x11-bridge}"
: "${REAL_XCLIP:=/usr/bin/xclip}"
: "${CCC_CLIPBOARD_PORT_FILE:=/run/ccc/clipboard.port}"
BRIDGE_SCRIPT=$(readlink -f "${BASH_SOURCE[0]}")
BRIDGE_POLICY="$(dirname "$BRIDGE_SCRIPT")/lib/clipboard-x11-sync.sh"
if [ ! -r "$BRIDGE_POLICY" ]; then
    BRIDGE_POLICY=/usr/local/lib/ccc/clipboard-x11-sync.sh
fi
if [ ! -r "$BRIDGE_POLICY" ]; then
    return 1 2>/dev/null || exit 1
fi
source "$BRIDGE_POLICY" || { return 1 2>/dev/null || exit 1; }

bridge_init() {
    umask 077
    bridge_tmp=$(mktemp -d "${TMPDIR:-/tmp}/ccc-clipboard.XXXXXXXX") || return 1
    bridge_ready_stage=""
    clipboard_x11_sync_init
    export DISPLAY="$DISPLAY_N"
}

bridge_cleanup() {
    if [ -n "${bridge_tmp:-}" ]; then
        rm -rf -- "$bridge_tmp"
        bridge_tmp=""
    fi
}

bridge_signature() {
    sha256sum < "$1" | cut -d' ' -f1
}

# Write bounded selection bytes to a private file, never a shell variable.
# Return 2 for oversized text so host polling cannot destroy that local copy.
bridge_read_local() {
    local result=0 target text_target=""
    # Some X11 owners return their bytes even for an unsupported target. A
    # successful UTF8_STRING request alone therefore does not prove text.
    (set -o pipefail; timeout -k 1 2 "$REAL_XCLIP" -selection clipboard -target TARGETS -out 2>/dev/null |
        head -c 65537 > "$bridge_tmp/local-targets") || return 1
    [ "$(wc -c < "$bridge_tmp/local-targets")" -le 65536 ] || return 1
    while IFS= read -r target; do
        case "$target" in
            UTF8_STRING) text_target=$target; break ;;
            text/plain|text/plain\;charset=utf-8|text/plain\;charset=UTF-8) text_target=$target ;;
        esac
    done < "$bridge_tmp/local-targets"
    [ -n "$text_target" ] || return 1
    (set -o pipefail; timeout -k 1 2 "$REAL_XCLIP" -selection clipboard -target "$text_target" -out 2>/dev/null |
        head -c 1048577 > "$bridge_tmp/local") || result=1
    [ "$(wc -c < "$bridge_tmp/local")" -le 1048576 ] || return 2
    return "$result"
}

# Failed target conversion is not proof of an unowned selection. Query the
# server directly, using Python and libX11 already shipped with the container.
bridge_selection_owner_absent() {
    timeout -k 1 2 /usr/bin/python3 - "$DISPLAY_N" 2>/dev/null <<'PY'
import ctypes
import os
import sys

try:
    x11 = ctypes.CDLL("libX11.so.6")
    x11.XOpenDisplay.argtypes = [ctypes.c_char_p]
    x11.XOpenDisplay.restype = ctypes.c_void_p
    x11.XInternAtom.argtypes = [ctypes.c_void_p, ctypes.c_char_p, ctypes.c_int]
    x11.XInternAtom.restype = ctypes.c_ulong
    x11.XGetSelectionOwner.argtypes = [ctypes.c_void_p, ctypes.c_ulong]
    x11.XGetSelectionOwner.restype = ctypes.c_ulong
    x11.XCloseDisplay.argtypes = [ctypes.c_void_p]
    display = x11.XOpenDisplay(os.fsencode(sys.argv[1]))
    if not display:
        sys.exit(2)
    try:
        atom = x11.XInternAtom(display, b"CLIPBOARD", 1)
        owner = x11.XGetSelectionOwner(display, atom) if atom else 0
    finally:
        x11.XCloseDisplay(display)
except Exception:
    sys.exit(2)
sys.exit(0 if owner == 0 else 1)
PY
}

bridge_http_get() {
    local endpoint=$1 destination=$2
    shift 2
    http_status=$(curl -fs --connect-timeout 2 --max-time 5 "$@" \
        -H "Authorization: Bearer $token" -o "$destination" -w '%{http_code}' \
        "$url/clipboard/$endpoint") || return 1
    case "$http_status" in 200|204) return 0 ;; *) return 1 ;; esac
}

bridge_read_host() {
    bridge_http_get image/png "$bridge_tmp/host-image" || return 1
    if [ "$http_status" = 200 ] && [ -s "$bridge_tmp/host-image" ]; then
        host_mode=image/png
        host_file="$bridge_tmp/host-image"
        host_sig="img:$(bridge_signature "$host_file")"
    else
        bridge_http_get text "$bridge_tmp/host-text" --max-filesize 1048576 || return 1
        [ "$(wc -c < "$bridge_tmp/host-text")" -le 1048576 ] || return 1
        host_mode=UTF8_STRING
        host_file="$bridge_tmp/host-text"
        host_sig="txt:$(bridge_signature "$host_file")"
    fi
}

bridge_apply_host() {
    timeout -k 1 2 "$REAL_XCLIP" -selection clipboard -target "$host_mode" -in \
        < "$host_file" >/dev/null 2>&1 || return 1

}

bridge_local_signature() {
    printf 'txt:%s' "$(bridge_signature "$bridge_tmp/local")"
}

bridge_upload_local() {
    local status
    status=$(curl -fs --connect-timeout 2 --max-time 10 \
        -H "Authorization: Bearer $token" \
        -H 'Content-Type: text/plain;charset=utf-8' \
        --data-binary @"$bridge_tmp/local" -o /dev/null -w '%{http_code}' \
        "$url/clipboard/text") || return 1
    case "$status" in 2??) return 0 ;; *) return 1 ;; esac
}

bridge_generation_pinned() {
    [[ "${CCC_CLIPBOARD_GENERATION:-}" =~ ^[a-f0-9]{12}$ ]]
}

# Caller-local URL/token variables retain their pairing for the whole cycle.
bridge_resolve_connection() {
    local record
    url=${CCC_CLIPBOARD_URL:-}
    token=${CCC_CLIPBOARD_TOKEN:-}
    if bridge_generation_pinned; then
        [ -n "$url" ] && [ -n "$token" ]
        return $?
    fi
    # Refresh the endpoint and credential as a pair, preserving the session host.
    if [ -f "$CCC_CLIPBOARD_PORT_FILE" ] && [ -r "$CCC_CLIPBOARD_PORT_FILE" ] &&
        record=$(awk -F: '
            NR == 1 && NF == 2 && $1 ~ /^[0-9]+$/ && length($1) <= 5 &&
            $1 > 0 && $1 <= 65535 && $2 ~ /^[A-Za-z0-9_-]+$/ { record = $0 }
            END { if (NR != 1 || record == "") exit 1; print record }
        ' "$CCC_CLIPBOARD_PORT_FILE" 2>/dev/null); then
        # CCC supplies an explicit port; keep other URL shapes on the fallback.
        case "${url##*:}" in
            ''|*[!0-9]*) ;;
            *)
                url="${url%:*}:${record%%:*}"
                token=${record#*:}
                ;;
        esac
    fi
    [ -n "$url" ] || return 1
}

bridge_connection_signature() {
    local url token generation=legacy
    bridge_resolve_connection || return 1
    if bridge_generation_pinned; then generation=$CCC_CLIPBOARD_GENERATION; fi
    printf '%s\0%s\0%s' "$generation" "$url" "$token" | sha256sum | cut -d' ' -f1
}

bridge_code_signature() {
    printf '%s:%s' "$(bridge_signature "$BRIDGE_SCRIPT")" "$(bridge_signature "$BRIDGE_POLICY")"
}

bridge_cycle() {
    local url token
    bridge_resolve_connection || return 1
    clipboard_x11_sync_cycle
}

bridge_mark_ready() {
    [ "$initialized" = 1 ] && [ -f "$LOCK_DIR/running" ] && [ ! -L "$LOCK_DIR/running" ] || return 1
    [ "$(head -n 1 "$LOCK_DIR/running")" = "$$" ] || return 1
    if [ -f "$LOCK_DIR/ready" ] && [ ! -L "$LOCK_DIR/ready" ] && cmp -s "$LOCK_DIR/running" "$LOCK_DIR/ready"; then
        return 0
    fi
    bridge_ready_stage=$(mktemp "$LOCK_DIR/.ready.XXXXXXXX") || return 1
    cp -- "$LOCK_DIR/running" "$bridge_ready_stage" || { rm -f -- "$bridge_ready_stage"; bridge_ready_stage=""; return 1; }
    if [ "$(head -n 1 "$LOCK_DIR/running")" = "$$" ] && cmp -s "$LOCK_DIR/running" "$bridge_ready_stage"; then
        mv -f -- "$bridge_ready_stage" "$LOCK_DIR/ready" || { rm -f -- "$bridge_ready_stage"; bridge_ready_stage=""; return 1; }
        bridge_ready_stage=""
    else
        rm -f -- "$bridge_ready_stage"
        bridge_ready_stage=""
        return 1
    fi
}

sync_loop() {
    bridge_init || return 1
    while :; do
        if bridge_cycle; then bridge_mark_ready || true; fi
        sleep 0.4
    done
}

# Only a bash process executing this exact script path can own the PID file.
# The /proc start-time token additionally detects PID reuse.
bridge_process_start() {
    local pid=$1 stat
    local -a argv fields
    [[ "$pid" =~ ^[0-9]+$ ]] && [ "$pid" -gt 1 ] || return 1
    [ -r "/proc/$pid/cmdline" ] || return 1
    mapfile -d '' -t argv < "/proc/$pid/cmdline"
    [ "${#argv[@]}" -ge 2 ] || return 1
    case "${argv[0]}" in bash|/bin/bash|/usr/bin/bash) ;; *) return 1 ;; esac
    [ "$(readlink -f "${argv[1]}")" = "$BRIDGE_SCRIPT" ] || return 1
    stat=$(cat "/proc/$pid/stat" 2>/dev/null) || return 1
    read -r -a fields <<< "${stat##*) }"
    [ "${#fields[@]}" -ge 20 ] || return 1
    printf '%s' "${fields[19]}"
}

bridge_exit() {
    bridge_cleanup
    # A replacement may already own the record; never remove its state.
    if [ -f "$LOCK_DIR/running" ] && [ "$(head -n 1 "$LOCK_DIR/running")" = "$$" ]; then
        if [ -f "$LOCK_DIR/ready" ] && [ ! -L "$LOCK_DIR/ready" ] && cmp -s "$LOCK_DIR/running" "$LOCK_DIR/ready"; then
            rm -f -- "$LOCK_DIR/ready"
        fi
        rm -f -- "$LOCK_DIR/running"
    fi
    if [ -n "${bridge_ready_stage:-}" ]; then rm -f -- "$bridge_ready_stage"; fi
}

# This mode observes an already-started bridge; it never claims or signals one.
bridge_wait_ready() {
    local generation connection observed i
    local -a state=()
    generation=$(bridge_code_signature) || return 1
    connection=$(bridge_connection_signature) || return 1
    for ((i=0; i<100; i++)); do
        if [ -f "$LOCK_DIR/running" ] && [ ! -L "$LOCK_DIR/running" ] &&
            [ -f "$LOCK_DIR/ready" ] && [ ! -L "$LOCK_DIR/ready" ]; then
            mapfile -t state < "$LOCK_DIR/running"
            if [ "${#state[@]}" = 4 ] && [ "${state[2]}" = "$generation" ] && [ "${state[3]}" = "$connection" ] &&
                observed=$(bridge_process_start "${state[0]}") && [ "$observed" = "${state[1]}" ] &&
                cmp -s "$LOCK_DIR/running" "$LOCK_DIR/ready"; then
                return 0
            fi
        fi
        sleep 0.1
    done
    return 1
}

bridge_main() {
    local generation connection pid start observed i
    local -a state=()
    umask 077
    mkdir -p "$LOCK_DIR" || return 1
    chmod 700 "$LOCK_DIR" || return 1
    # Serialize startup/replacement, but release before spawning child owners.
    exec 9>"$LOCK_DIR/startup.lock" || return 1
    flock -w 10 9 || return 1
    generation=$(bridge_code_signature) || return 1
    connection=$(bridge_connection_signature) || return 1
    if [ -f "$LOCK_DIR/running" ]; then
        mapfile -t state < "$LOCK_DIR/running"
        pid=${state[0]:-}
        if observed=$(bridge_process_start "$pid"); then
            start=${state[1]:-$observed}
            if [ "$observed" = "$start" ]; then
                if [ "${state[2]:-}" = "$generation" ] && [ "${state[3]:-}" = "$connection" ]; then
                    exec 9>&-
                    return 0
                fi
                # Recheck identity immediately before signaling, never just kill
                # an arbitrary live PID found in a stale lock file.
                [ "$(bridge_process_start "$pid")" = "$start" ] || return 1
                kill -TERM "$pid" 2>/dev/null || return 1
                for ((i=0; i<120; i++)); do
                    [ "$(bridge_process_start "$pid")" = "$start" ] || break
                    sleep 0.1
                done
                [ "$(bridge_process_start "$pid")" != "$start" ] || return 1
            fi
        fi
    fi
    start=$(bridge_process_start "$$") || return 1
    printf '%s\n' "$$" "$start" "$generation" "$connection" > "$LOCK_DIR/running.new"
    mv -f "$LOCK_DIR/running.new" "$LOCK_DIR/running"
    trap bridge_exit EXIT
    trap 'exit 0' TERM INT

    # Reuse an existing X server, including one started by the previous bridge.
    if [ ! -S "/tmp/.X11-unix/X${DISPLAY_N#:}" ]; then
        Xvfb "$DISPLAY_N" -screen 0 1024x768x24 -nolisten tcp 9>&- >/dev/null 2>&1 &
        for ((i=0; i<20; i++)); do
            [ -S "/tmp/.X11-unix/X${DISPLAY_N#:}" ] && break
            sleep 0.1
        done
    fi
    exec 9>&-
    sync_loop
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    case "${1:-}" in
        '') bridge_main ;;
        --wait-ready) bridge_wait_ready ;;
        *) exit 2 ;;
    esac
fi
