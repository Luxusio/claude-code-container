#!/bin/sh
# xclip shim - proxies clipboard requests to CCC host clipboard server
# Supports the exact invocation patterns used by Claude Code:
#   xclip -selection clipboard -t TARGETS -o
#   xclip -selection clipboard -t image/png -o
#   xclip -selection clipboard -t image/bmp -o
#   xclip -selection clipboard -t text/plain -o
#   xclip -selection clipboard -o

if [ -z "$CCC_CLIPBOARD_URL" ]; then
    echo "xclip: clipboard not available (not running in CCC session)" >&2
    exit 1
fi

# Refresh port and token from one valid record after a daemon restart.
# Keep the session hostname (including bracketed IPv6) and fallback together.
if [ -f /run/ccc/clipboard.port ] && [ -r /run/ccc/clipboard.port ] &&
    _clipboard_record=$(awk -F: '
        NR == 1 && NF == 2 && $1 ~ /^[0-9]+$/ && length($1) <= 5 &&
        $1 > 0 && $1 <= 65535 && $2 ~ /^[A-Za-z0-9_-]+$/ { record = $0 }
        END { if (NR != 1 || record == "") exit 1; print record }
    ' /run/ccc/clipboard.port 2>/dev/null); then
    # CCC supplies an explicit port. Refuse to reinterpret another URL shape.
    case "${CCC_CLIPBOARD_URL##*:}" in
        ''|*[!0-9]*) ;;
        *)
            CCC_CLIPBOARD_URL="${CCC_CLIPBOARD_URL%:*}:${_clipboard_record%%:*}"
            CCC_CLIPBOARD_TOKEN=${_clipboard_record#*:}
            ;;
    esac
fi

# Parse arguments
SELECTION=""
TARGET=""
OUTPUT=0
INPUT=0

while [ $# -gt 0 ]; do
    case "$1" in
        -selection)
            [ $# -ge 2 ] || { echo "xclip: missing selection" >&2; exit 1; }
            SELECTION="$2"
            shift 2
            ;;
        -t|-target)
            [ $# -ge 2 ] || { echo "xclip: missing target" >&2; exit 1; }
            TARGET="$2"
            shift 2
            ;;
        -o|-out)
            OUTPUT=1
            shift
            ;;
        -i|-in)
            INPUT=1
            shift
            ;;
        *)
            echo "xclip: unsupported clipboard option" >&2
            exit 1
            ;;
    esac
done

case "$SELECTION" in
    clipboard|c) ;;
    *) echo "xclip: only clipboard selection is supported" >&2; exit 1 ;;
esac
[ "$INPUT" = 0 ] || [ "$OUTPUT" = 0 ] || {
    echo "xclip: conflicting input/output options" >&2
    exit 1
}

# Helper: fetch text endpoint, fail if empty
_fetch_text() {
    _data=$(curl -sf --connect-timeout 3 --max-time 10 -H "Authorization: Bearer $CCC_CLIPBOARD_TOKEN" "$1" 2>/dev/null) || { echo "xclip: clipboard server error" >&2; exit 1; }
    [ -n "$_data" ] || { echo "xclip: clipboard is empty" >&2; exit 1; }
    printf '%s' "$_data"
}

# Helper: fetch binary endpoint to temp file, fail if empty
_fetch_binary() {
    _tmp=$(mktemp)
    trap 'rm -f "$_tmp"' EXIT
    if curl -sf --connect-timeout 3 --max-time 10 -H "Authorization: Bearer $CCC_CLIPBOARD_TOKEN" -o "$_tmp" "$1" 2>/dev/null && [ -s "$_tmp" ]; then
        cat "$_tmp"
    else
        echo "xclip: clipboard is empty or server error" >&2
        exit 1
    fi
}

# Preserve host-to-container text and image paste.
if [ "$OUTPUT" = "1" ]; then
    case "$TARGET" in
        TARGETS)
            _fetch_text "$CCC_CLIPBOARD_URL/clipboard/targets"
            ;;
        image/png)
            _fetch_binary "$CCC_CLIPBOARD_URL/clipboard/image/png"
            ;;
        image/bmp)
            _fetch_binary "$CCC_CLIPBOARD_URL/clipboard/image/bmp"
            ;;
        image/*)
            _fetch_binary "$CCC_CLIPBOARD_URL/clipboard/image/png"
            ;;
        text/plain|"")
            _fetch_text "$CCC_CLIPBOARD_URL/clipboard/text"
            ;;
        *)
            _fetch_text "$CCC_CLIPBOARD_URL/clipboard/text"
            ;;
    esac
    exit 0
fi

case "$TARGET" in
    ""|UTF8_STRING|STRING|text/plain|text/plain\;charset=utf-8|text/plain\;\ charset=utf-8|text/plain\;charset=UTF-8|text/plain\;\ charset=UTF-8) ;;
    *) echo "xclip: only UTF-8 text copy is supported" >&2; exit 1 ;;
esac
_status=$(curl -fs --connect-timeout 3 --max-time 10 \
    -H "Authorization: Bearer $CCC_CLIPBOARD_TOKEN" \
    -H "Content-Type: text/plain;charset=utf-8" \
    --data-binary @- -o /dev/null -w '%{http_code}' \
    "$CCC_CLIPBOARD_URL/clipboard/text") || {
    echo "xclip: clipboard server error" >&2
    exit 1
}
case "$_status" in
    2??) exit 0 ;;
    *) echo "xclip: clipboard server error" >&2; exit 1 ;;
esac
