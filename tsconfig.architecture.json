{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "rootDir": "."
  },
  "include": [
    "packages/device-lab/providers/domain/**/*.mjs",
    "packages/device-lab/providers/ports/**/*.mjs",
    "packages/device-lab/providers/application/**/*.mjs",
    "packages/device-lab/providers/adapters/lock-publication-times.mjs",
    "packages/device-lab/providers/adapters/physical-attachment.mjs",
    "packages/device-lab/providers/adapters/direct-recording.mjs",
    "packages/device-lab/providers/adapters/ios-control-transfer.mjs",
    "packages/device-lab/providers/adapters/desktop-access-result.mjs",
    "packages/device-lab/providers/adapters/mobile-inventory.mjs",
    "packages/device-lab/providers/state/physical-lease-store.mjs",
    "packages/device-lab/providers/state/broker-owner-secret.mjs",
    "device-lab-mcp/src/domain/**/*.mjs",
    "device-lab-mcp/src/ports/**/*.mjs",
    "device-lab-mcp/src/application/**/*.mjs",
    "scripts/install/application.mjs",
    "scripts/install/domain.mjs",
    "src/domain/**/*.ts",
    "src/ports/**/*.ts",
    "src/application/**/*.ts",
    "packages/device-lab/src/device-lab/domain/**/*.ts",
    "packages/device-lab/src/device-lab/ports/**/*.ts",
    "packages/device-lab/src/device-lab/application/**/*.ts",
    "src/__tests__/architecture/**/*.ts",
    "src/__tests__/device-lab-application-boundary.test.ts",
    "src/__tests__/device-lab-application-readiness.test.ts"
  ],
  "exclude": []
}
